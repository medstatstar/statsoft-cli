    "installed": true,
    "version": "[MODELER_VERSION]",
    "path": "[IBMSPSS_MODELER_INSTALL_PATH]/bin/clemb.exe",
    "mode": "simple"
  },
  "Stata": {
    "installed": true,
    "path": "[STATA_INSTALL_PATH]",
